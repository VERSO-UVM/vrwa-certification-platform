# Hosted / shared MySQL (used by the app, db:migrate, db:seed, db:studio)
# mysql://user:password@host:port/database-name
#
# If the password contains reserved URI characters ( < > ) # @ : / ? & = ),
# percent-encode them. Example: < → %3C   ) → %29
#   python3 -c 'import urllib.parse; print(urllib.parse.quote("YOUR_PASSWORD", safe=""))'
#
# UVM webdb also needs the CA cert (same as ~/.my.cnf ssl-ca):
DATABASE_URL=mysql://root:verso@localhost:13306/vrwa
DATABASE_SSL_CA=/Users/rzia/.webdb-cacert.pem

# Local Docker MySQL only (used by bun db:dev). Must be localhost / 127.0.0.1.
# Matches backend/compose.dev.yml (Percona 8.0 on port 13306).
LOCAL_DATABASE_URL=mysql://root:verso@localhost:13306/vrwa

# Better-auth
BETTER_AUTH_SECRET=InProdThisWillBeASecurelyGeneratedSecret
BETTER_AUTH_URL=http://localhost:3000

# Stripe
STRIPE_API_SECRET_KEY=sk_ThisKeyShouldBeSecret
STRIPE_API_PUBLIC_KEY=pk_ThisKeyIsPubliclySharable
STRIPE_WEBHOOK_SECRET=whsec_DontShareThisWebhookSecret

## Server configuration defaults
# HOST=0.0.0.0
# PORT=3000
# WEBAPP_URL=http://localhost:5173
