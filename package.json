{
  "name": "vrwa",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "backend",
      "webapp"
    ],
    "catalog": {
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "typescript": "^7.0.2",
      "better-auth": "1.7.0-rc.5",
      "auth": "1.7.0-rc.5",
      "superjson": "^2.2.6"
    }
  },
  "scripts": {
    "dev": "FORCE_COLOR=1 bun --elide-lines=0 --filter=\"*\" run dev",
    "lint": "eslint \"{backend,webapp}/{src,app}/**/*.ts*\" --fix",
    "format": "prettier --write \"{backend,webapp}/{src,app}/**/*.ts*\"",
    "typecheck": "bun tsc -p backend; bun tsc -p webapp",
    "db:dev": "FORCE_COLOR=1 bun --elide-lines=0 --filter=backend run db:dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "trustedDependencies": [
    "@swc/core",
    "@tailwindcss/oxide",
    "esbuild"
  ]
}
