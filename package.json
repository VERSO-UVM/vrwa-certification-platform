{
  "name": "vrwa",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "webapp"
  ],
  "scripts": {
    "dev": "FORCE_COLOR=1 bun --elide-lines=0 --filter=\"*\" --bun run dev",
    "lint": "eslint \"{backend,webapp}/{src,app}/**/*.ts*\" --fix",
    "format": "prettier --write \"{backend,webapp}/{src,app}/**/*.ts*\"",
    "typecheck": "bun tsc -p backend; bun tsc -p webapp",
    "db:dev": "FORCE_COLOR=1 bun --elide-lines=0 --filter=backend run db:dev",
    "build": "npm run build -w backend && npm run build -w webapp",
    "start:backend": "npm start -w backend",
    "start:webapp": "npm start -w webapp"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.9",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "trustedDependencies": [
    "@swc/core",
    "@tailwindcss/oxide",
    "esbuild"
  ]
}
